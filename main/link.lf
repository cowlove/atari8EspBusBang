[mapping:main]
archive: libmain.a
entries:
    # The Core0 group is gathered first; align iloop_pbi to the next 32 KiB bank
    # boundary so the two hot instruction streams cannot share a bank.
    * (core0_hotspots)
    main:iloop_pbi (noflash); text->iram0_text KEEP() ALIGN(32768)

[sections:core0_hotspots]
entries:
    .literal.core0_hotspots
    .text.core0_hotspots

[scheme:core0_hotspots]
entries:
    core0_hotspots -> iram0_text
