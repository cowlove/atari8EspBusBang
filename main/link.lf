# ldgen conditions name Kconfig options WITHOUT the CONFIG_ prefix: with it,
# the symbol is unknown, the condition is silently false, and the else
# branch (or nothing) applies.
[mapping:main]
archive: libmain.a
entries:
    # The system monitor runs hot (sysMonitor.h): its code, vtables and
    # constants in internal RAM.
    if A8BB_SYSMONITOR = y:
        sysMonitor (noflash)
        # ... except what never runs hot: building the menus, the cold
        # work (SYSMON_COLD).
        sysMonitor:sysmon_cold (default)
    # LOGHOT()'s formatter (nanoprintf) runs hot: internal RAM.
    if A8BB_LOG_VIA_SIDECAR = y:
        a8logFmt (noflash)
    # Default: leave Core0 hotspots in normal IRAM placement. The post-link
    # verifier rejects a collision with iloop_pbi without introducing padding.
    if A8BB_CORE0_HOTSPOTS_EXPLICIT_PLACEMENT = y:
        * (core0_hotspots)
        main:iloop_pbi (noflash); text->iram0_text KEEP() ALIGN(32768)
        core1:iloop_pbi (noflash); text->iram0_text KEEP() ALIGN(32768)
        * (iloop_pbi_literals)
    else:
        # ALIGN(4096): WiFi off (2026-11-17) left iloop_pbi 4 KB short of
        # IRAM bank 2, in bank 1 with core 0's hotspots; the 4 KB step puts
        # it in bank 2 (up to 4 KB of padding). verify_iram_hotspots.py
        # still checks every build.
        main:iloop_pbi (noflash); text->iram0_text KEEP() ALIGN(4096)
        core1:iloop_pbi (noflash); text->iram0_text KEEP() ALIGN(4096)
        * (iloop_pbi_literals)

# The i2slink polling loops (I2SLINK_HOT_ATTR, components/i2slink)
# joins the Core0 hotspots; without explicit placement it is IRAM_ATTR.
# With explicit placement this doesn't separate them yet: ldgen sorts IRAM
# code by archive, so libi2slink's lands after iloop_pbi's ALIGN, in
# its bank (verify_iram_hotspots.py fails the build).
[mapping:i2slink]
archive: libi2slink.a
entries:
    if A8BB_CORE0_HOTSPOTS_EXPLICIT_PLACEMENT = y:
        * (core0_hotspots)
    else:
        * (default)

[sections:iloop_pbi_literals]
entries:
    .literal._Z9iloop_pbiIL14CartBankSelect0EEvv
    .literal._Z9iloop_pbiIL14CartBankSelect1EEvv

[scheme:iloop_pbi_literals]
entries:
    iloop_pbi_literals -> iram0_text

[sections:core0_hotspots]
entries:
    .literal.core0_hotspots
    .text.core0_hotspots

[scheme:core0_hotspots]
entries:
    core0_hotspots -> iram0_text
