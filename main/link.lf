# ldgen conditions name Kconfig options WITHOUT the CONFIG_ prefix: with it,
# the symbol is unknown, the condition is silently false, and the else
# branch (or nothing) applies.
[mapping:main]
archive: libmain.a
entries:
    # The system monitor runs hot (sysMonitor.h): its code, vtables and
    # constants in internal RAM.
    if A8BB_SYSMONITOR = y:
        sysMonitor (noflash)
        # ... except what never runs hot: building the menus, the cold
        # work (SYSMON_COLD).
        sysMonitor:sysmon_cold (default)
    # LOGHOT()'s formatter (nanoprintf) runs hot: internal RAM. Unconditional
    # (a fragment sees only Kconfig, and A8BB_LOG_VIA_SIDECAR is a CMake
    # option): without it a8logFmt.cpp compiles to nothing.
    a8logFmt (noflash)
    # Core 1's loop (iloop_pbi) is not mapped here: main/core1_last.ld
    # places it last in IRAM, after every other IRAM input, with no padding
    # (an ALIGN(8192) here cost 6-6.6 KB). Core 0's hotspots: normal IRAM
    # placement by default; verify_iram_hotspots.py checks they stay out of
    # the loop's bank. Explicit placement gathers them in one place.
    if A8BB_CORE0_HOTSPOTS_EXPLICIT_PLACEMENT = y:
        * (core0_hotspots)

# The i2slink polling loops (I2SLINK_HOT_ATTR, components/i2slink) join
# the Core0 hotspots; without explicit placement they are IRAM_ATTR.
[mapping:i2slink]
archive: libi2slink.a
entries:
    if A8BB_CORE0_HOTSPOTS_EXPLICIT_PLACEMENT = y:
        * (core0_hotspots)
    else:
        * (default)

[sections:core0_hotspots]
entries:
    .literal.core0_hotspots
    .text.core0_hotspots

[scheme:core0_hotspots]
entries:
    core0_hotspots -> iram0_text
