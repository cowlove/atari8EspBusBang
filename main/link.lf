[mapping:main]
archive: libmain.a
entries:
    # The system monitor runs hot (sysMonitor.h): its code, vtables and
    # constants in internal RAM.
    if A8BB_SYSMONITOR = y:
        sysMonitor (noflash)
        # ... except what never runs hot: building the menus, the cold
        # work (SYSMON_COLD).
        sysMonitor:sysmon_cold (default)
    # Default: leave Core0 hotspots in normal IRAM placement. The post-link
    # verifier rejects a collision with iloop_pbi without introducing padding.
    if CONFIG_A8BB_CORE0_HOTSPOTS_EXPLICIT_PLACEMENT = y:
        * (core0_hotspots)
        main:iloop_pbi (noflash); text->iram0_text KEEP() ALIGN(32768)
        core1:iloop_pbi (noflash); text->iram0_text KEEP() ALIGN(32768)
    else:
        main:iloop_pbi (noflash); text->iram0_text KEEP() ALIGN(64)
        core1:iloop_pbi (noflash); text->iram0_text KEEP() ALIGN(64)
        * (iloop_pbi_literals)

# The i2slink polling loops (SIDECAR_HOT_ATTR, components/sidecar_link)
# joins the Core0 hotspots; without explicit placement it is IRAM_ATTR.
[mapping:sidecar_link]
archive: libsidecar_link.a
entries:
    if CONFIG_A8BB_CORE0_HOTSPOTS_EXPLICIT_PLACEMENT = y:
        * (core0_hotspots)
    else:
        * (default)

[sections:iloop_pbi_literals]
entries:
    .literal._Z9iloop_pbiIL14CartBankSelect0EEvv
    .literal._Z9iloop_pbiIL14CartBankSelect1EEvv

[scheme:iloop_pbi_literals]
entries:
    iloop_pbi_literals -> iram0_text

[sections:core0_hotspots]
entries:
    .literal.core0_hotspots
    .text.core0_hotspots

[scheme:core0_hotspots]
entries:
    core0_hotspots -> iram0_text
