CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
# The capture's tick constants assume 240 MHz.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
# The profiling task spins on core 1 with interrupts masked for each chunk.
CONFIG_ESP_INT_WDT=n
CONFIG_ESP_TASK_WDT_EN=n
# No PSRAM, SPIFFS or Wi-Fi: the app only samples pins and prints.
# -O2, unlike the Sidecar app's -Og: the C fall-wait poll and the analysis
# between captures run faster.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
