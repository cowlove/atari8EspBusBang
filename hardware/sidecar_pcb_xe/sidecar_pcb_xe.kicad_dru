(version 1)
# J1's card-edge fingers run to the board edge by design.
(rule "card edge fingers"
	(condition "A.memberOfFootprint('J1') && A.Type == 'Pad'")
	(constraint edge_clearance (min 0mm)))
# J9 (GCT USB4105, KiCad's footprint per GCT's land pattern): its GND pads
# sit 0.19 mm from its own locating-peg holes (NPTH).
(rule "USB-C locating pegs"
	(condition "A.memberOfFootprint('J9') && B.memberOfFootprint('J9')")
	(constraint hole_clearance (min 0.15mm)))
