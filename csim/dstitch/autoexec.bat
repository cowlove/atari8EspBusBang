POKE 729,0
ECHO OFF 
DIR D2:

; small overwrite big, also test rename leave ONEBYTE for final cmp
COPY D1:FOO D2:FOO
COPY D1:ONEBYTE D2:FOO
RENAME D2:FOO ONEBYTE

; multi-sector append, leave BIGP1 for final cmp
COPY D1:ONEBYTE D2:BIGP1
COPY D1:BIG D2:BIGP1/A

; big overwrite small, leave BIG for final cmp
COPY D1:ONEBYTE D2:BIG
COPY D1:BIG D2:BIG

; sector-aligned append, leave FOOFOO for final cmp
COPY D1:FOO D2:FOO
COPY D2:FOO D2:FOOFOO
COPY D2:FOO D2:FOOFOO/A

; erase, make sure ERASEME is not in backing store
COPY D2:FOO D2:ERASEME
ERASE D2:ERASEME

; ping-pong append copy, leave BIG16 for final cmp
; BIG16 is initialized to 1x BIG.
COPY D1:BIG D2:BIG16
; Appending 1x BIG makes BIG16 2x BIG.
COPY D2:BIG D2:BIG16/A
; Copying BIG16 makes BIG16.2 2x BIG.
COPY D2:BIG16 D2:BIG16.2
; Appending 2x BIG makes BIG16 4x BIG.
COPY D2:BIG16.2 D2:BIG16/A
; Appending 4x BIG to the existing 2x makes BIG16.2 6x BIG.
COPY D2:BIG16 D2:BIG16.2/A
; Appending 6x BIG to the existing 4x makes BIG16 10x BIG.
COPY D2:BIG16.2 D2:BIG16/A
; Appending 10x BIG to the existing 6x makes BIG16.2 16x BIG.
COPY D2:BIG16 D2:BIG16.2/A
; After deleting the old BIG16 and renaming BIG16.2, BIG16 is 16x BIG.
ERASE D2:BIG16
RENAME D2:BIG16.2 BIG16

:DONE
DIR D2:
ECHO DONE WITH TEST 
COPY D1:ONEBYTE D1:DONE
:STOP
GOTO STOP

;; NORMAL TESTS
COPY D1:FOO D2:FOO
COPY D1:BAR D2:BAR
SET COUNT=
:LOOP
; loop top
COPY D2:BAR D2:FOO2
COPY D2:FOO D2:FOO2
COPY D2:FOO D2:BAR2
COPY D2:BAR D2:BAR2
COPY D2:FOO2 D2:FOO
COPY D2:BAR2 D2:BAR
DIR D2:
; loop bottom
SET COUNT=$COUNT$X
IF NOT "$COUNT$" == "XXX" 
GOTO LOOP
FI
ERASE D2:FOO
DIR D2:
COPY D2:FOO2 D1:FOO2
COPY D2:BAR2 D1:BAR2
COPY D2:FOO2 D1:DONE
