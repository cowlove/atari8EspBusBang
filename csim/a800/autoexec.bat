ECHO ON 
SET COUNT=X
SET HALTFILE=D3:\HALT
SET OUTDIR=D5:\

DIR $OUTDIR /A

SET PATH=D2:\UTILS\FILEUTIL\CRC32;$PATH
DIR $OUTDIR$
MKDIR $OUTDIR$
:LOOP
POKE 77,0
;ERASE /Y $OUTDIR$\*.*
DIR $OUTDIR$\

; small overwrite big, also test rename leave ONEBYTE for final cmp
COPY D1:FOO O:\FOO
COPY O:\FOO $OUTDIR$\FOO
COPY D1:ONEBYTE $OUTDIR$\FOO
RENAME $OUTDIR$\FOO ONEBYTE

; multi-sector append, leave BIGP1 for final cmp
COPY D1:\ONEBYTE $OUTDIR$\BIGP1
COPY D1:\BIG $OUTDIR$\BIGP1/A

; big overwrite small, leave BIG for final cmp
COPY D1:\ONEBYTE $OUTDIR$\BIG
COPY D1:\BIG O:\BIG
COPY O:\BIG $OUTDIR$\BIG

; sector-aligned append, leave FOOFOO for final cmp
COPY D1:\FOO O:\FOO
COPY O:\FOO $OUTDIR$\FOO
COPY $OUTDIR$\FOO $OUTDIR$\FOOFOO
;;;; COPY $OUTDIR$\ONEBYTE $OUTDIR$\FOOFOO/A ; deliberately corrupt file to test failure
COPY $OUTDIR$\FOO $OUTDIR$\FOOFOO/A

; erase, make sure ERASEME is not in backing store
COPY $OUTDIR$\FOO $OUTDIR$\ERASEME
ERASE $OUTDIR$\ERASEME

; ping-pong append copy, leave BIG16 for final cmp
; BIG16 is initialized to 1x BIG.
COPY D1:BIG $OUTDIR$\BIG16
; Appending 1x BIG makes BIG16 2x BIG.
COPY $OUTDIR$\BIG $OUTDIR$\BIG16/A
; Copying BIG16 makes BIG16.2 2x BIG.
COPY $OUTDIR$\BIG16 $OUTDIR$\BIG16.2
; Appending 2x BIG makes BIG16 4x BIG.
COPY $OUTDIR$\BIG16.2 $OUTDIR$\BIG16/A
COPY $OUTDIR$\BIG16 $OUTDIR$\BIG4
; Appending 4x BIG to the existing 2x makes BIG16.2 6x BIG.
COPY $OUTDIR$\BIG16 $OUTDIR$\BIG16.2/A
; Appending 6x BIG to the existing 4x makes BIG16 10x BIG.
COPY $OUTDIR$\BIG16.2 $OUTDIR$\BIG16/A
; Appending 10x BIG to the existing 6x makes BIG16.2 16x BIG.
COPY $OUTDIR$\BIG16 $OUTDIR$\BIG16.2/A
; After deleting the old BIG16 and renaming BIG16.2, BIG16 is 16x BIG.
ERASE $OUTDIR$\BIG16
RENAME $OUTDIR$\BIG16.2 BIG16
DIR $OUTDIR$\

D1:\CMPHALT.EXE D1:\FOO $OUTDIR$\FOO    1  $HALTFILE
D1:\CMPHALT.EXE D1:\FOO $OUTDIR$\FOOFOO 2  $HALTFILE
D1:\CMPHALT.EXE D1:\BIG $OUTDIR$\BIG    1  $HALTFILE
D1:\CMPHALT.EXE D1:\BIG $OUTDIR$\BIG4   4  $HALTFILE
D1:\CMPHALT.EXE D1:\BIG $OUTDIR$\BIG16  16 $HALTFILE
;CRC32 $OUTDIR$\BIG16
DIR $OUTDIR$\
SET COUNT=$COUNT$X
ECHO TEST PASSED LOOP COUNT $COUNT$ >>D3:LOG

GOTO LOOP



