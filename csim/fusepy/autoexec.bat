POKE 729,0
DIR D2:
COPY D1:FOO D2:FOO
COPY D1:BAR D2:BAR

SET LOOPCOUNT=0
:LOOP
; loop top
COPY D2:BAR D2:FOO2
COPY D2:FOO D2:FOO2
COPY D2:FOO D2:BAR2
COPY D2:BAR D2:BAR2
COPY D2:FOO2 D2:FOO
COPY D2:BAR2 D2:BAR
DIR D2:
; loop bottom
SET LOOPCOUNT=%LOOPCOUNT%+1
IF %LOOPCOUNT% < 5
GOTO LOOP
FI

ERASE D2:FOO
DIR D2:
COPY D2:FOO2 D1:FOO2
COPY D2:BAR2 D1:BAR2
COPY D2:FOO2 D1:DONE

