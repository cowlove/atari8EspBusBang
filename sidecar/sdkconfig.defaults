CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
# The service loop spins on core 1 and never blocks.
CONFIG_ESP_INT_WDT=n
CONFIG_ESP_TASK_WDT_EN=n

# The host's flash layout (../partitions.csv): the spiffs partition at the
# same offset and size, so the host's spiffs.bin flashes here unchanged
# (tools/flash_spiffs.sh -p <sidecar port>).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions.csv"

# SPIFFS as the host has it, to mount the same image (spiffs/Makefile builds
# it with --no-magic --no-magic-len --meta-len 4, no mtime).
CONFIG_SPIFFS_MAX_PARTITIONS=1
# The read cache is RAM only (the on-flash format is unchanged): without it
# every lookup-page scan of an in-place write is a flash read. No write
# cache: the disk images stay open, so a cached sector write could sit in
# RAM indefinitely and be lost on a reset.
CONFIG_SPIFFS_CACHE=y
# CONFIG_SPIFFS_CACHE_WR is not set
# CONFIG_SPIFFS_USE_MAGIC is not set
# CONFIG_SPIFFS_USE_MTIME is not set

# PSRAM as on the host (compressed .atr.gz images inflate into it). A board
# without it still boots; compressed images then fail to open.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Console on USB-Serial-JTAG only, as on the host: the app reads commands
# from it (flash/reset/dl/report, sidecarApp.cpp), and ESP-IDF takes input
# only from the primary console. UART0 (GPIO43/44) stays free.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
