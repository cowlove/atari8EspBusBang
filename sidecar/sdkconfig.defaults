CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
# -O2: the Sidecar serves the link, and its response time is the link's
# latency (at -Og a frame's write alone took ~77 us; bench, 2026-11-19).
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# The service loop spins on core 1 and never blocks.
CONFIG_ESP_INT_WDT=n
CONFIG_ESP_TASK_WDT_EN=n

# The Sidecar's own flash layout (sidecar/partitions.csv): a trimmed app
# and a large spiffs, whose image sidecar/flash_spiffs.sh builds (not the
# host's spiffs.bin, which no longer fits here).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# SPIFFS as the host has it, to mount the same image (spiffs/Makefile builds
# it with --no-magic --no-magic-len --meta-len 4, no mtime).
CONFIG_SPIFFS_MAX_PARTITIONS=1
# The read cache is RAM only (the on-flash format is unchanged): without it
# every lookup-page scan of an in-place write is a flash read. The write
# cache too (user, 2026-11-14: speed over durability on a hobby system): a
# sector written to an open disk image can sit in RAM until the cache
# flushes, and a reset loses it.
CONFIG_SPIFFS_CACHE=y
CONFIG_SPIFFS_CACHE_WR=y
# CONFIG_SPIFFS_USE_MAGIC is not set
# CONFIG_SPIFFS_USE_MTIME is not set

# PSRAM as on the host (compressed .atr.gz images inflate into it). A board
# without it still boots; compressed images then fail to open.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Console on USB-Serial-JTAG only, as on the host: the app reads commands
# from it (flash/reset/dl/report, sidecarApp.cpp), and ESP-IDF takes input
# only from the primary console. UART0 (GPIO43/44) stays free.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# No build time/date in the app description: the same source builds the
# same image, so its ELF SHA-256 (BootStatus appVersion) names it.
# CONFIG_APP_COMPILE_TIME_DATE is not set
# CONFIG_BOOTLOADER_COMPILE_TIME_DATE is not set

# Core dumps of the Sidecar's own crashes, to its coredump partition
# (partitions.csv), as main has them: ELF, task stacks only (no DRAM), the
# panic handler on its own stack. boot.sh -sc reads it after a
# "Backtrace:" on this console and decodes it against sidecar/build's ELF.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=64
CONFIG_ESP_COREDUMP_USE_STACK_SIZE=y
CONFIG_ESP_COREDUMP_STACK_SIZE=1792

# The network (sidecarNet.cpp): WiFi and lwIP buffers in PSRAM where they
# can be, leaving internal RAM to the link and SD/SPIFFS.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
