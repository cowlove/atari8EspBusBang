FROM debian:bookworm-slim

ARG DEBIAN_FRONTEND=noninteractive
ENV HOME=/root \
    IDF_PATH=/opt/esp-idf \
    IDF_TOOLS_PATH=/opt/espressif \
    ESP_IDF_PREFIX=/opt/esp-idf \
    LLVM_MOS_PREFIX=/opt/llvm-mos

COPY --chmod=755 setup-build-env.sh install-llvm-mos-sdk.sh /opt/atari8esp-setup/
COPY idf-submodule-overrides.txt /opt/atari8esp-setup/
COPY patches/spiffs-fs-by-label.patch /opt/atari8esp-setup/patches/spiffs-fs-by-label.patch

RUN /opt/atari8esp-setup/setup-build-env.sh idf

RUN /opt/atari8esp-setup/setup-build-env.sh llvm-mos

ENV LLVM_MOS_BIN=/opt/llvm-mos/bin \
    PATH=/opt/llvm-mos/bin:${PATH}

WORKDIR /workspace
ENTRYPOINT ["/bin/bash", "-lc", "source \"${IDF_PATH}/export.sh\" >/dev/null && exec \"$@\"", "--"]
CMD ["bash"]
