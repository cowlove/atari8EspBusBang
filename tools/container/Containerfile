FROM debian:bookworm-slim

ARG DEBIAN_FRONTEND=noninteractive
ARG IDF_REPO=https://github.com/espressif/esp-idf.git
ARG IDF_COMMIT=02c5f2dbb95859bc4a35fb6d82bbc0784968efc5

ENV HOME=/home/jim \
    IDF_PATH=/home/jim/esp/esp-idf \
    IDF_TOOLS_PATH=/home/jim/.espressif

RUN apt-get update && apt-get install -y --no-install-recommends \
        bash bison ca-certificates ccache cmake dfu-util flex g++ gcc git \
        gperf libffi-dev libssl-dev libusb-1.0-0 make patch pkg-config \
        python3 python3-dev python3-pip python3-venv wget xa65 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /home/jim/esp /home/jim/.espressif

COPY idf-submodule-overrides.txt /tmp/idf-submodule-overrides.txt
COPY patches/spiffs-fs-by-label.patch /tmp/spiffs-fs-by-label.patch

RUN set -eu \
    && git init "${IDF_PATH}" \
    && git -C "${IDF_PATH}" remote add origin "${IDF_REPO}" \
    && git -C "${IDF_PATH}" fetch --depth=1 origin "${IDF_COMMIT}" \
    && git -C "${IDF_PATH}" checkout --detach FETCH_HEAD \
    && git -C "${IDF_PATH}" submodule update --init --recursive --depth=1

RUN set -eu \
    && while read -r revision submodule; do \
        test -n "${submodule}" || continue; \
        git -C "${IDF_PATH}/${submodule}" fetch --depth=1 origin "${revision}" \
        && git -C "${IDF_PATH}/${submodule}" checkout --detach "${revision}" \
        || exit 1; \
    done < /tmp/idf-submodule-overrides.txt

RUN git -C "${IDF_PATH}" apply /tmp/spiffs-fs-by-label.patch

RUN "${IDF_PATH}/install.sh" esp32s3

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-numpy \
    && rm -rf /var/lib/apt/lists/* \
    && wget --quiet https://www.floodgap.com/retrotech/xa/dists/xa-2.4.1.tar.gz -O /tmp/xa-2.4.1.tar.gz \
    && echo '63c12a6a32a8e364f34f049d8b2477f4656021418f08b8d6b462be0ed3be3ac3  /tmp/xa-2.4.1.tar.gz' | sha256sum --check --status \
    && tar -xzf /tmp/xa-2.4.1.tar.gz -C /tmp \
    && make -C /tmp/xa-2.4.1 xa \
    && install -D -m 755 /tmp/xa-2.4.1/xa /home/jim/bin/xa \
    && rm -rf /tmp/xa-2.4.1 /tmp/xa-2.4.1.tar.gz

WORKDIR /workspace
ENTRYPOINT ["/bin/bash", "-lc", "source /home/jim/esp/esp-idf/export.sh >/dev/null && exec \"$@\"", "--"]
CMD ["bash"]
