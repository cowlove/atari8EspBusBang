ECHO ON
ECHO X.BAT V1.1
MEM
TYPE D1:CONFIG.SYS
CAR:RAMDISK.SYS O: 8
ECHO ENTER "J:":DOS >>X
ECHO BASIC <<X
ERASE D2:RUNTIME.COM
:LOOP
;PEEK 88
;MDUMP 39968 32
;PEEK 560 
;MDUMP 40960 8
ECHO BASIC <<X
ECHO LOCAL COPIES
COPY D1:A D2:A
COPY D2:A D2:B
COPY D2:B D2:A
DIR D2:
ECHO BASIC <<X
ECHO RAMDISK COPIES 
COPY D2:A O:A
COPY O:A O:B
COPY O:B O:C
COPY O:C D2:D
ECHO BASIC <<X
DIR O:
SET HALTFILE=D3:\HALT
D2:CMPHALT.EXE D1:A D2:A 1 $HALTFILE$
D2:CMPHALT.EXE D1:A D2:D 1 $HALTFILE$
ECHO BASIC <<X
ERASE D2:A
ERASE D2:B
ERASE O:A
ERASE O:B
ERASE O:C
ECHO BASIC <<X
SET SMBMOUNT=D4:
ECHO SMB COPIES
COPY $SMBMOUNT$\FOO $SMBMOUNT$\FOO2
COPY $SMBMOUNT$\FOO2 $SMBMOUNT$\FOO3
DIR $SMBMOUNT$\
ECHO LOOP COMPLETE >>D3:\LOG
ECHO BASIC <<X
GOTO LOOP
